# =================================================================
# Open Tours Ceylon — Gmail SMTP OTP Authentication Configuration
# =================================================================

# Your Gmail address used as the sender
EMAIL_USER=your-email@gmail.com

# 16-character Google App Password (https://myaccount.google.com/apppasswords)
# Important: Requires 2-Step Verification enabled on the Gmail account.
EMAIL_PASS=your-16-char-app-password

# Server listening port (default: 3000)
PORT=3000
