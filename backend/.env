# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=4000
MONGO_URI=mongodb://localhost:27017/opentours_ceylon

# Use a long, random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# The only email that is ever granted Master Admin privileges.
# Checked server-side on every admin-protected request — never trust a client-sent role.
PRIMARY_ADMIN_EMAIL=tharushageethma@gmail.com

# OTP settings
OTP_LENGTH=6
OTP_TTL_MINUTES=10

# Plug in a real provider for production. Leaving these unset makes the
# OTP routes fall back to a "dev mode" that logs the code to the server
# console instead of sending it — fine for local testing, never for prod.
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
